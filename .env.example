# Aura 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== AI 模型配置 ====================
# 阿里云百炼 API Key（Qwen3.7-Plus 调用需要）
# 申请地址: https://bailian.console.aliyun.com
QWEN_API_KEY=your_api_key_here

# ==================== 数据库配置 ====================
DB_PASSWORD=aura123

# ==================== 安全配置 ====================
# JWT 签名密钥（生产环境请使用强密钥）
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars

# ==================== 可选配置 ====================
# 日志级别
LOG_LEVEL=DEBUG

# 服务端口
SERVER_PORT=8080
